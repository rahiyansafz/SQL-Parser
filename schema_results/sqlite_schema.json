  "views": [
    {
      "name": "product_details",
      "definition": "SELECT \r\n  p.id, \r\n  p.name, \r\n  p.description, \r\n  p.price, \r\n  p.stock_quantity, \r\n  c.name AS cate",
      "sourceTables": []
    },
    {
      "name": "product_inventory",
      "definition": "SELECT \r\n  p.id,\r\n  p.name,\r\n  p.stock_quantity,\r\n  CASE \r\n    WHEN p.stock_quantity = 0 THEN 'Out of stock'\r\n    WHEN p.stock_quantity < 10 THEN 'Low stock'\r\n    ELSE 'In stock'\r\n  END AS stock_status\r\nFROM products p",
      "sourceTables": [
        "products"
      ]
    }
  ],
  "storedProcedures": [],
  "functions": [],
  "triggers": [
    {
      "name": "trg_product_inventory_update",
      "table": "stock_quantity",
      "timing": "AFTER",
      "events": [
        "UPDATE"
      ],
      "body": "ON products\r\nBEGIN\r\n    \r\n    SELECT CASE \r\n        WHEN NEW.stock_quantity = 0 THEN 'Out of stock'\r\n        WHEN NEW.stock_quantity < 10 THEN 'Low stock'\r\n        ELSE 'In stock'",
      "affectedTables": []
    },
    {
      "name": "trg_order_status_updated",
      "table": "orders",
      "timing": "AFTER",
      "events": [
        "UPDATE"
      ],
      "body": "WHEN OLD.status != NEW.status\r\nBEGIN\r\n  INSERT INTO order_status_history (order_id, old_status, new_status, updated_at)\r\n  VALUES (NEW.id, OLD.status, NEW.status, datetime('now'))",
      "affectedTables": [
        "order_status_history"
      ]
    }
  ],
