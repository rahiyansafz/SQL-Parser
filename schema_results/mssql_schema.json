  "views": [
    {
      "name": "ProductDetails",
      "definition": "SELECT \r\n  p.id, \r\n  p.name, \r\n  p.description, \r\n  p.price, \r\n  p.stock_quantity, \r\n  c.name AS cate",
      "sourceTables": []
    },
    {
      "name": "ProductInventory",
      "definition": "SELECT \r\n  p.id,\r\n  p.name,\r\n  p.stock_quantity,\r\n  dbo.GetStockStatus(p.stock_quantity) AS stock_status\r\nFROM Products p",
      "sourceTables": [
        "Products"
      ]
    }
  ],
  "storedProcedures": [
    {
      "name": "GetUserOrders",
      "parameters": [],
      "body": "@userId INT\r\nAS\r\nBEGIN\r\n  SELECT o.id, o.status, o.total_amount, o.created_at,\r\n         oi.product_id, p.name as product_name, oi.quantity, oi.price_per_unit\r\n  FROM Orders o\r\n  JOIN OrderItems oi ON o.id = oi.order_id\r\n  JOIN Products p ON oi.product_id = p.id\r\n  WHERE o.user_id = @userId\r\n  ORDER BY o.created_at DESC",
      "affectedTables": [
        "Orders",
        "OrderItems",
        "Products"
      ]
    },
    {
      "name": "UpdateProductStock",
      "parameters": [],
      "body": "@productId INT,\r\n  @newQuantity INT\r\nAS\r\nBEGIN\r\n  UPDATE Products\r\n  SET stock_quantity = @newQuantity,\r\n      updated_at = GETDATE()\r\n  WHERE id = @productId",
      "affectedTables": [
        "Products"
      ]
    }
  ],
