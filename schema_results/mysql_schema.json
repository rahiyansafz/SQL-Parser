  "views": [
    {
      "name": "product_details",
      "definition": "SELECT \r\n  p.id, \r\n  p.name, \r\n  p.description, \r\n  p.price, \r\n  p.stock_quantity, \r\n  c.name AS cate",
      "sourceTables": []
    }
  ],
  "storedProcedures": [
    {
      "name": "get_user_orders",
      "parameters": [
        {
          "name": "user_id_param",
          "dataType": "INT",
          "direction": "IN"
        }
      ],
      "body": "SELECT o.id, o.status, o.total_amount, o.created_at,\r\n         oi.product_id, p.name as product_name, oi.quantity, oi.price_per_unit\r\n  FROM orders o\r\n  JOIN order_items oi ON o.id = oi.order_id\r\n  JOIN products p ON oi.product_id = p.id\r\n  WHERE o.user_id = user_id_param\r\n  ORDER BY o.created_at DESC;",
      "comment": "",
      "affectedTables": [
        "orders",
        "order_items",
        "products"
      ]
    },
    {
      "name": "update_product_stock",
      "parameters": [
        {
          "name": "product_id_param",
          "dataType": "INT",
          "direction": "IN"
        },
        {
          "name": "new_quantity",
          "dataType": "INT",
          "direction": "IN"
        }
      ],
      "body": "UPDATE products\r\n  SET stock_quantity = new_quantity,\r\n      updated_at = NOW()\r\n  WHERE id = product_id_param;\r\n  \r\n  -- Log the stock update\r\n  SELECT CONCAT('Stock updated for product ', product_id_param, ' to ', new_quantity) AS message;",
      "comment": "",
      "affectedTables": [
        "products"
      ]
    }
  ],
  "functions": [],
  "triggers": [
    {
      "name": "trg_order_status_updated",
      "table": "orders",
      "timing": "AFTER",
      "events": [
        "UPDATE"
      ],
      "body": "FOR EACH ROW\r\nBEGIN\r\n  IF NEW.status != OLD.status THEN\r\n    INSERT INTO order_status_history (order_id, old_status, new_status, updated_at)\r\n    VALUES (NEW.id, OLD.status, NEW.status, NOW())",
      "affectedTables": [
        "order_status_history"
      ]
    }
  ],
