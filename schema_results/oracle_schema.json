      "body": "ON orders\r\nFOR EACH ROW\r\nBEGIN\r\n  IF :NEW.status != :OLD.status THEN\r\n    INSERT INTO order_status_history (order_id, old_status, new_status, updated_at)\r\n    VALUES (:NEW.id, :OLD.status, :NEW.status, CURRENT_TIMESTAMP)",
