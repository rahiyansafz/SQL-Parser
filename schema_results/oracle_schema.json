  "views": [
    {
      "name": "product_details",
      "definition": "SELECT \r\n  p.id, \r\n  p.name, \r\n  p.description, \r\n  p.price, \r\n  p.stock_quantity, \r\n  c.name AS cate",
      "sourceTables": []
    },
    {
      "name": "product_inventory",
      "definition": "SELECT \r\n  p.id,\r\n  p.name,\r\n  p.stock_quantity,\r\n  get_stock_status(p.stock_quantity) AS stock_status\r\nFROM products p",
      "sourceTables": [
        "products"
      ]
    }
  ],
  "storedProcedures": [
    {
      "name": "get_user_orders",
      "parameters": [
        {
          "name": "user_id_param",
          "dataType": "IN NUMBER",
          "direction": "IN"
        }
      ],
      "body": "BEGIN\r\n  \r\n  FOR ord_rec IN (\r\n      SELECT o.id, o.status, o.total_amount, o.created_at,\r\n             oi.product_id, p.name as product_name, oi.quantity, oi.price_per_unit\r\n      FROM orders o\r\n      JOIN order_items oi ON o.id = oi.order_id\r\n      JOIN products p ON oi.product_id = p.id\r\n      WHERE o.user_id = user_id_param\r\n      ORDER BY o.created_at DESC\r\n  ) LOOP\r\n    \r\n    DBMS_OUTPUT.PUT_LINE('Order ID: ' || ord_rec.id)",
      "affectedTables": [
        "orders",
        "order_items",
        "products"
      ]
    },
    {
      "name": "update_product_stock",
      "parameters": [
        {
          "name": "product_id_param",
          "dataType": "IN NUMBER",
          "direction": "IN"
        },
        {
          "name": "new_quantity",
          "dataType": "IN NUMBER",
