      "returnType": "VARCHAR2",
      "body": "status VARCHAR2(20);\r\nBEGIN\r\n  IF stock = 0 THEN\r\n    status := 'Out of stock';\r\n  ELSIF stock < 10 THEN\r\n    status := 'Low stock';\r\n  ELSE\r\n    status := 'In stock';",
